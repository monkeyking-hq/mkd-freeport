# SPDX-License-Identifier: MIT

pkgname=mkd-freeport-bin
_pkgname=mkd-freeport
pkgver=0.4.0
pkgrel=1
pkgdesc='Discover and reserve TCP/UDP ports over IPv4 and IPv6 for scripts and AI agents (prebuilt)'
arch=('x86_64' 'aarch64')
url='https://github.com/monkeyking-hq/mkd-freeport'
license=('MIT')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source_x86_64=("${url}/releases/download/v${pkgver}/${_pkgname}-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/${_pkgname}-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local _arch_target
    if [[ "${CARCH}" == "aarch64" ]]; then
        _arch_target="aarch64-unknown-linux-musl"
    else
        _arch_target="x86_64-unknown-linux-musl"
    fi
    cd "${_pkgname}-v${pkgver}-${_arch_target}"
    install -Dm755 mkd-freeport "${pkgdir}/usr/bin/mkd-freeport"
    install -Dm644 man/mkd-freeport.1 "${pkgdir}/usr/share/man/man1/mkd-freeport.1"
    install -Dm644 completions/mkd-freeport.bash "${pkgdir}/usr/share/bash-completion/completions/mkd-freeport"
    install -Dm644 completions/_mkd-freeport "${pkgdir}/usr/share/zsh/site-functions/_mkd-freeport"
    install -Dm644 completions/mkd-freeport.fish "${pkgdir}/usr/share/fish/vendor_completions.d/mkd-freeport.fish"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
